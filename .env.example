# Secrets du digest pipeline. Ne jamais commiter ni partager ce fichier.
# n8n ne lit pas ce fichier : recopier chaque valeur dans le credential correspondant.

# Salesforce (app cliente externe "n8n Digest Pipeline") → credential "Salesforce OAuth2 API"
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_ENVIRONMENT=production

# Slack (app bot, scopes chat:write + files:write) → credential "Slack API"
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# SMTP interne → credential "SMTP"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Destinataire des alertes d'échec
RESPONSABLE_EMAIL=
